{
  "name": "batto-obs-tool",
  "version": "2.1.0",
  "private": true,
  "description": "Batto OBS Tool – OBS-Produktion, TikTok LIVE Studio/API-Hybrid, Multi-Plattform-Chat, Overlays, Touch-Deck und Creator-Werkzeuge",
  "author": "Crazy_Batto / Team Alpha",
  "main": "src/main.cjs",
  "scripts": {
    "prepare:integrated": "node scripts/verify-source-tree.cjs && node scripts/patch-commercial-settings.cjs",
    "pretest": "npm run prepare:integrated",
    "check": "node scripts/verify-source-tree.cjs && node scripts/check-icon.cjs",
    "test:core": "node --test test/commercial-settings.test.cjs test/hybrid-runtime.test.cjs test/cng-config.test.cjs test/hardware-enrichment-v2.test.cjs",
    "test:modules": "node --test test/multi-chat.test.cjs modules/encoder-monitoring-overlay/test/*.test.cjs modules/twitch-holo-chat/test/*.test.cjs",
    "test": "npm run check && npm run test:core && npm run test:modules",
    "test:legacy-2.0": "node scripts/check-2.0.0.cjs && node --test test/integrated-2.0.0.test.cjs test/touch-deck-pro-v2.test.cjs",
    "pack:win": "npm run prepare:integrated && electron scripts/generate-icon.cjs && electron-builder --win --x64 --dir --publish never",
    "predist:win": "npm run prepare:integrated && electron scripts/generate-icon.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "tiktok-live-connector": "^2.4.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "de.crazybatto.battoobstool",
    "productName": "Batto OBS Tool",
    "artifactName": "Batto-OBS-Tool-Setup-${version}.${ext}",
    "asar": true,
    "files": ["src/**/*", "modules/**/*", "resources/**/*", "package.json"],
    "extraResources": [
      {"from": "build/license.txt", "to": "Nutzungs-und-Lizenzbedingungen.txt"},
      {"from": "resources/team-logo.png", "to": "resources/team-logo.png"},
      {"from": "resources/team-logo.svg", "to": "resources/team-logo.svg"},
      {"from": "resources/cng-chat-config.example.json", "to": "resources/cng-chat-config.example.json"}
    ],
    "directories": {"output": "dist", "buildResources": "build"},
    "win": {
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "target": [{"target": "nsis", "arch": ["x64"]}]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true
    }
  }
}
