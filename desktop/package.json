{
  "name": "batto-obs-tool",
  "version": "2.0.0",
  "private": true,
  "description": "Batto OBS Tool – OBS-Steuerung, Hardwarediagnose, Overlays, Touch-Deck, Multi-Chat, Plugins und lokale Handy-Steuerung",
  "author": "Crazy_Batto / Team Alpha",
  "main": "src/main.cjs",
  "scripts": {
    "prepare:integrated": "node scripts/prepare-2.0.0-integrated.cjs && node scripts/patch-2.0.0-integrated.cjs",
    "pretest": "npm run prepare:integrated",
    "check": "node scripts/check-2.0.0.cjs",
    "test": "npm run check && node --test test/integrated-2.0.0.test.cjs modules/encoder-monitoring-overlay/test/*.test.cjs modules/twitch-holo-chat/test/*.test.cjs",
    "predist:win": "npm run prepare:integrated",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "de.crazybatto.battoobstool",
    "productName": "Batto OBS Tool",
    "artifactName": "Batto-OBS-Tool-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "src/**/*",
      "modules/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/license.txt",
        "to": "Nutzungs-und-Lizenzbedingungen.txt"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "shortcutName": "Batto OBS Tool",
      "license": "build/license.txt",
      "include": "build/installer.nsh"
    }
  }
}
